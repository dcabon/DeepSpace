@page
@using DeepSpace.Core.Entities
@model DeepSpace.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Deep Space — Astronomia i fizyka bez clickbaitu";
    ViewData["MetaDescription"] = "Aktualności z astronomii i fizyki: kosmos, misje, teleskopy, ISS i quizy naukowe.";
    ViewData["MetaKeywords"] = "space, physics, astronomy, kosmos, astronomia, fizyka";
    ViewData["OgDescription"] = ViewData["MetaDescription"];
}

<div class="masthead">
    <div class="masthead-content">
        <h1 class="masthead-title">@Model.HomePageH1</h1>
        <p class="masthead-tagline">@Model.HomePageSubtitle</p>
        <div class="masthead-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</div>
    </div>
</div>

@section Scripts {
<script>
function getLocationDescription(lat, lon) {
    // Oceany
    if (lon >= -80 && lon <= 0 && lat >= -60 && lat <= 60)
        return "Ocean Atlantycki";
    if (lon >= 20 && lon <= 120 && lat >= -60 && lat <= 30)
        return "Ocean Indyjski";
    if ((lon >= 100 || lon <= -100) && lat >= -60 && lat <= 60)
        return "Ocean Spokojny";
    if (lat <= -60)
        return "Ocean Południowy";
    if (lat >= 70)
        return "Ocean Arktyczny";

    // Kontynenty
    if (lon >= -10 && lon <= 40 && lat >= 35 && lat <= 70)
        return "Europa";
    if (lon >= 40 && lon <= 180 && lat >= 10 && lat <= 75)
        return "Azja";
    if (lon >= -20 && lon <= 55 && lat >= -35 && lat <= 35)
        return "Afryka";
    if (lon >= -170 && lon <= -50 && lat >= 15 && lat <= 75)
        return "Ameryka Północna";
    if (lon >= -85 && lon <= -30 && lat >= -60 && lat <= 15)
        return "Ameryka Południowa";
    if (lon >= 110 && lon <= 180 && lat >= -50 && lat <= -10)
        return "Australia i Oceania";
    if (lat <= -60)
        return "Antarktyda";

    return "Nad oceanem";
}

async function refreshIssData() {
    const btn = document.querySelector('.iss-refresh-btn');
    if (btn) btn.classList.add('spinning');
    
    try {
        // Pobierz pozycję ISS
        const response = await fetch('https://api.wheretheiss.at/v1/satellites/25544');
        const data = await response.json();
        
        const date = new Date(data.timestamp * 1000);
        const formattedDate = date.toLocaleString('pl-PL', {
            day: '2-digit',
            month: '2-digit', 
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        }).replace(',', '');
        
        const location = getLocationDescription(data.latitude, data.longitude);
        
        document.getElementById('issLocation').textContent = '🌍 ' + location;
        document.getElementById('issTimestamp').textContent = formattedDate;
        document.getElementById('issLatitude').textContent = data.latitude.toFixed(4) + '°';
        document.getElementById('issLongitude').textContent = data.longitude.toFixed(4) + '°';
        document.getElementById('issAltitude').textContent = Math.round(data.altitude);
        document.getElementById('issVelocity').textContent = Math.round(data.velocity);
    } catch (error) {
        console.error('Błąd pobierania danych ISS:', error);
        document.getElementById('issLocation').textContent = '⚠️ Błąd połączenia';
    } finally {
        if (btn) btn.classList.remove('spinning');
    }
}

async function loadAstronauts() {
    try {
        const response = await fetch('https://api.open-notify.org/astros.json');
        const data = await response.json();
        
        const issAstronauts = data.people.filter(p => p.craft === 'ISS');
        
        if (issAstronauts.length > 0) {
            document.getElementById('issCrewCount').textContent = issAstronauts.length;
            const list = document.getElementById('issCrewList');
            list.replaceChildren(...issAstronauts.map(a => {
                const item = document.createElement('li');
                item.textContent = a.name;
                return item;
            }));
            document.getElementById('issCrew').style.display = 'block';
        }
    } catch (error) {
        console.error('Błąd pobierania listy astronautów:', error);
    }
}

// Toggle collapsible sections
function toggleCollapsible(btn) {
    const parent = btn.closest('.collapsible');
    parent.classList.toggle('expanded');
}

// Toggle mobile sidebar widgets
function toggleMobileWidget(element) {
    if (window.innerWidth <= 900) {
        element.classList.toggle('mobile-expanded');
    }
}

// Załaduj dane przy starcie strony
document.addEventListener('DOMContentLoaded', function() {
    refreshIssData();
    loadAstronauts();
    
    // Add click handlers for mobile collapsible widgets
    const issWidget = document.getElementById('issWidget');
    const quizCard = document.querySelector('.sidebar-quiz-card');
    
    if (issWidget) {
        issWidget.addEventListener('click', function(e) {
            // Don't toggle if clicking on refresh button or collapsible toggle
            if (e.target.closest('.iss-refresh-btn') || e.target.closest('.collapsible-toggle')) return;
            toggleMobileWidget(this);
        });
    }
    
    if (quizCard) {
        quizCard.addEventListener('click', function(e) {
            if (window.innerWidth <= 900) {
                if (!this.classList.contains('mobile-expanded')) {
                    e.preventDefault();
                    this.classList.add('mobile-expanded');
                }
            }
        });
    }
});
</script>
}

@if (Model.FeaturedArticle != null)
{
    var featured = Model.FeaturedArticle;
    <a href="/artykul/@featured.Slug" class="featured-hero">
        <div class="featured-hero-image">
            @if (!string.IsNullOrEmpty(featured.ImageUrl))
            {
                <img src="@featured.ImageUrl" alt="@featured.Title" />
            }
            <div class="featured-hero-overlay"></div>
        </div>
        <div class="featured-hero-container">
            <div class="featured-hero-content">
                <span class="article-category">@featured.Category.Name</span>
                <h2 class="featured-hero-title">@featured.Title</h2>
                <p class="featured-hero-summary">@featured.Summary</p>
                <div class="article-meta">
                    <time>@featured.PublishedAt.ToString("d MMMM yyyy")</time>
                    @if (!string.IsNullOrEmpty(featured.SourceName))
                    {
                        <span class="meta-separator">·</span>
                        <span>@featured.SourceName</span>
                    }
                </div>
            </div>
        </div>
    </a>
}

<div class="homepage-content with-sidebar">
        <aside class="homepage-sidebar">
            <div class="sidebar-iss-widget" id="issWidget">
                <div class="iss-widget-header">
                    <span class="iss-icon">🛰️</span>
                    <div>
                        <span class="sidebar-label">ISS - Na żywo</span>
                        <span class="iss-live-dot"></span>
                    </div>
                    <button class="iss-refresh-btn" onclick="refreshIssData()" title="Odśwież dane">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 2v6h-6"></path>
                            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
                            <path d="M3 22v-6h6"></path>
                            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
                        </svg>
                    </button>
                </div>
                
                <div class="iss-location" id="issLocation">
                    <span class="iss-loading">Ładowanie...</span>
                </div>
                
                <div class="iss-timestamp" id="issTimestamp"></div>
                
                <div class="iss-position">
                    <div class="iss-coord">
                        <span class="coord-label">Szerokość</span>
                        <span class="coord-value" id="issLatitude">--</span>
                    </div>
                    <div class="iss-coord">
                        <span class="coord-label">Długość</span>
                        <span class="coord-value" id="issLongitude">--</span>
                    </div>
                </div>
                
                <div class="iss-stats">
                    <div class="iss-stat">
                        <span class="stat-value" id="issAltitude">--</span>
                        <span class="stat-label">km wysokości</span>
                    </div>
                    <div class="iss-stat">
                        <span class="stat-value" id="issVelocity">--</span>
                        <span class="stat-label">km/h</span>
                    </div>
                </div>
                
                <div class="iss-crew collapsible" id="issCrew" style="display: none;">
                    <button class="collapsible-toggle" onclick="toggleCollapsible(this)">
                        <h4>Załoga na pokładzie (<span id="issCrewCount">0</span>)</h4>
                        <span class="collapsible-icon">▼</span>
                    </button>
                    <ul id="issCrewList" class="collapsible-content"></ul>
                </div>
            </div>

            @if (Model.FeaturedQuiz != null)
            {
            <div class="sidebar-sticky">
            <a href="/quiz/@Model.FeaturedQuiz.Slug" class="sidebar-quiz-card">
                <div class="sidebar-quiz-image">
                    <img src="@(Model.FeaturedQuiz.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=600")" alt="@Model.FeaturedQuiz.Title" />
                    <div class="sidebar-quiz-overlay"></div>
                </div>
                <div class="sidebar-quiz-content">
                    <span class="sidebar-label">Quiz dnia</span>
                    <h3>@Model.FeaturedQuiz.Title</h3>
                    @if (!string.IsNullOrEmpty(Model.FeaturedQuiz.Description))
                    {
                        <p>@Model.FeaturedQuiz.Description</p>
                    }
                    <div class="sidebar-quiz-meta">
                        <span class="sidebar-quiz-badge">@Model.FeaturedQuiz.Questions.Count pytań</span>
                        <span class="sidebar-quiz-cta">Rozwiąż quiz →</span>
                    </div>
                </div>
            </a>
            </div>
            }
        </aside>

    <div class="homepage-main">
        @if (Model.LatestArticles.Any() || Model.FeaturedInGridArticle != null)
        {
            <section class="articles-section">
                <div class="section-header">
                    <h2>Najnowsze</h2>
                    <div class="section-line"></div>
                </div>
                
                @{
                    var featuredGrid = Model.FeaturedInGridArticle;
                    var latestArticles = Model.LatestArticles.ToList();
                    
                    // Jeśli jest wyróżniony - pierwszy wiersz specjalny
                    if (featuredGrid != null)
                    {
                        var sideArticle = latestArticles.FirstOrDefault();
                        <div class="articles-grid-featured">
                            <a href="/artykul/@featuredGrid.Slug" class="article-featured-grid">
                                <img src="@(featuredGrid.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1200")" alt="@featuredGrid.Title" />
                                <div class="article-featured-grid-overlay"></div>
                                <div class="article-featured-grid-content">
                                    <span class="featured-badge">WYRÓŻNIONE</span>
                                    <span class="article-category">@featuredGrid.Category.Name</span>
                                    <h3>@featuredGrid.Title</h3>
                                    <p>@featuredGrid.Summary</p>
                                    <div class="article-meta">
                                        <time>@featuredGrid.PublishedAt.ToString("d MMMM yyyy")</time>
                                    </div>
                                </div>
                            </a>
                            @if (sideArticle != null)
                            {
                                <a href="/artykul/@sideArticle.Slug" class="article-side-card">
                                    <div class="article-side-image">
                                        <img src="@(sideArticle.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=800")" alt="@sideArticle.Title" />
                                    </div>
                                    <div class="article-side-content">
                                        <span class="article-category">@sideArticle.Category.Name</span>
                                        <h3>@sideArticle.Title</h3>
                                        <p>@sideArticle.Summary</p>
                                        <div class="article-meta">
                                            <time>@sideArticle.PublishedAt.ToString("d MMMM yyyy")</time>
                                        </div>
                                    </div>
                                </a>
                                latestArticles = latestArticles.Skip(1).ToList();
                            }
                        </div>
                    }
                    
                    // Reszta artykułów - standardowy grid 3 kolumny
                    if (latestArticles.Any())
                    {
                        <div class="articles-grid">
                            @foreach (var article in latestArticles)
                            {
                                <article class="article-card">
                                    <a href="/artykul/@article.Slug" class="article-link">
                                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                                        {
                                            <div class="article-image-wrapper">
                                                <img src="@article.ImageUrl" alt="@article.Title" class="article-image" />
                                            </div>
                                        }
                                        <div class="article-content">
                                            <span class="article-category">@article.Category.Name</span>
                                            <h3 class="article-title">@article.Title</h3>
                                            <p class="article-summary">@article.Summary</p>
                                            <div class="article-meta">
                                                <time>@article.PublishedAt.ToString("d MMMM yyyy")</time>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }

        @foreach (var categoryData in Model.CategoriesWithArticles)
        {
            <section class="articles-section category-section">
                <div class="section-header">
                    <h2>@categoryData.Category.Name</h2>
                    <div class="section-line"></div>
                    <a href="/kategoria/@categoryData.Category.Slug" class="section-more">
                        Więcej <span>→</span>
                    </a>
                </div>
                
                @{
                    var catArticles = categoryData.Articles;
                    var catIndex = 0;
                    while (catIndex < catArticles.Count)
                    {
                        var remaining = catArticles.Count - catIndex;
                        
                        if (remaining == 1)
                        {
                            var article = catArticles[catIndex];
                            <a href="/artykul/@article.Slug" class="article-solo">
                                <img src="@(article.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1200")" alt="@article.Title" />
                                <div class="article-solo-overlay"></div>
                                <div class="article-solo-content">
                                    <span class="article-category">@article.Category.Name</span>
                                    <h3>@article.Title</h3>
                                    <p>@article.Summary</p>
                                    <div class="article-meta">
                                        <time>@article.PublishedAt.ToString("d MMMM yyyy")</time>
                                    </div>
                                </div>
                            </a>
                            catIndex += 1;
                        }
                        else if (remaining == 2)
                        {
                            var first = catArticles[catIndex];
                            var second = catArticles[catIndex + 1];
                            <div class="article-duo">
                                <a href="/artykul/@first.Slug" class="article-duo-large">
                                    <div class="article-duo-large-image">
                                        <img src="@(first.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1200")" alt="@first.Title" />
                                    </div>
                                    <div class="article-duo-large-content">
                                        <span class="article-category">@first.Category.Name</span>
                                        <h3>@first.Title</h3>
                                        <p>@first.Summary</p>
                                        <div class="article-meta">
                                            <time>@first.PublishedAt.ToString("d MMMM yyyy")</time>
                                        </div>
                                    </div>
                                </a>
                                <a href="/artykul/@second.Slug" class="article-duo-small">
                                    <img src="@(second.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=800")" alt="@second.Title" />
                                    <div class="article-duo-small-overlay"></div>
                                    <div class="article-duo-small-content">
                                        <span class="article-category">@second.Category.Name</span>
                                        <h3>@second.Title</h3>
                                        <div class="article-meta">
                                            <time>@second.PublishedAt.ToString("d MMMM yyyy")</time>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            catIndex += 2;
                        }
                        else
                        {
                            var a1 = catArticles[catIndex];
                            var a2 = catArticles[catIndex + 1];
                            var a3 = catArticles[catIndex + 2];
                            <div class="articles-grid">
                                <article class="article-card">
                                    <a href="/artykul/@a1.Slug" class="article-link">
                                        @if (!string.IsNullOrEmpty(a1.ImageUrl))
                                        {
                                            <div class="article-image-wrapper">
                                                <img src="@a1.ImageUrl" alt="@a1.Title" class="article-image" />
                                            </div>
                                        }
                                        <div class="article-content">
                                            <span class="article-category">@a1.Category.Name</span>
                                            <h3 class="article-title">@a1.Title</h3>
                                            <p class="article-summary">@a1.Summary</p>
                                            <div class="article-meta">
                                                <time>@a1.PublishedAt.ToString("d MMMM yyyy")</time>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                                <article class="article-card">
                                    <a href="/artykul/@a2.Slug" class="article-link">
                                        @if (!string.IsNullOrEmpty(a2.ImageUrl))
                                        {
                                            <div class="article-image-wrapper">
                                                <img src="@a2.ImageUrl" alt="@a2.Title" class="article-image" />
                                            </div>
                                        }
                                        <div class="article-content">
                                            <span class="article-category">@a2.Category.Name</span>
                                            <h3 class="article-title">@a2.Title</h3>
                                            <p class="article-summary">@a2.Summary</p>
                                            <div class="article-meta">
                                                <time>@a2.PublishedAt.ToString("d MMMM yyyy")</time>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                                <article class="article-card">
                                    <a href="/artykul/@a3.Slug" class="article-link">
                                        @if (!string.IsNullOrEmpty(a3.ImageUrl))
                                        {
                                            <div class="article-image-wrapper">
                                                <img src="@a3.ImageUrl" alt="@a3.Title" class="article-image" />
                                            </div>
                                        }
                                        <div class="article-content">
                                            <span class="article-category">@a3.Category.Name</span>
                                            <h3 class="article-title">@a3.Title</h3>
                                            <p class="article-summary">@a3.Summary</p>
                                            <div class="article-meta">
                                                <time>@a3.PublishedAt.ToString("d MMMM yyyy")</time>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            </div>
                            catIndex += 3;
                        }
                    }
                }
            </section>
        }
    </div>
</div>
