@page "/artykul/{slug}"
@model DeepSpace.Web.Pages.ArtykulModel
@{
    ViewData["Title"] = Model.Article!.Title + " — Deep Space";
    ViewData["OgTitle"] = Model.Article.Title;
    ViewData["OgDescription"] = Model.Article.Summary;
    ViewData["OgImage"] = Model.Article.ImageUrl;
    
    var articleUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/artykul/{Model.Article.Slug}";
    var encodedUrl = Uri.EscapeDataString(articleUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Article.Title);
    
    var hasSections = Model.Sections.Count > 1;
    var hasContent = !string.IsNullOrEmpty(Model.Article.Content);
}

<article class="article-page">
    <header class="article-header">
        <a href="/kategoria/@Model.Article.Category.Slug" class="article-category">@Model.Article.Category.Name</a>
        <h1>@Model.Article.Title</h1>
        <div class="article-meta">
            <time>@Model.Article.PublishedAt.ToString("d MMMM yyyy")</time>
            @if (!string.IsNullOrEmpty(Model.Article.SourceName))
            {
                <span class="meta-separator">·</span>
                @if (!string.IsNullOrEmpty(Model.Article.SourceUrl))
                {
                    <a href="@Model.Article.SourceUrl" target="_blank" rel="noopener">@Model.Article.SourceName</a>
                }
                else
                {
                    <span>@Model.Article.SourceName</span>
                }
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.Article.ImageUrl))
    {
        <div class="article-featured-image">
            <div class="article-featured-image-wrapper">
                <img src="@Model.Article.ImageUrl" alt="@Model.Article.Title" />
            </div>
        </div>
    }

    <div class="article-container @(hasSections ? "with-sidebar" : "")">
        @if (hasSections)
        {
            <aside class="article-toc">
                <div class="article-toc-inner">
                    <h4>Spis treści</h4>
                    <nav>
                        @foreach (var sec in Model.Sections)
                        {
                            <a href="#@sec.Slug" class="toc-link">@sec.Title</a>
                        }
                    </nav>
                </div>
            </aside>
        }

        <div class="article-main">
            @if (hasContent && !Model.Sections.Any())
            {
                <div class="article-body">
                    @Html.Raw(Model.Article.Content)
                </div>
            }
            else if (Model.Sections.Any())
            {
                @foreach (var sec in Model.Sections)
                {
                    <div class="article-section" id="@sec.Slug">
                        <h2>@sec.Title</h2>
                        <div class="article-body">
                            @Html.Raw(sec.Content)
                        </div>
                    </div>
                }
            }

            @if (Model.Tags.Any())
            {
                <div class="article-tags">
                    <h4>Tagi</h4>
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="/tag/@tag.Slug" class="tag">@tag.Name</a>
                    }
                </div>
            }

            <div class="share-section">
                <span class="share-label">Udostępnij artykuł</span>
                <div class="share-buttons">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" 
                       target="_blank" rel="noopener" class="share-btn">
                        Facebook
                    </a>
                    <a href="https://wa.me/?text=@encodedTitle%20@encodedUrl" 
                       target="_blank" rel="noopener" class="share-btn">
                        WhatsApp
                    </a>
                    <button class="share-btn" onclick="copyLink()">
                        <span id="copyText">Kopiuj link</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</article>

@if (Model.RelatedArticles.Any())
{
    <div class="related-articles">
        <div class="related-articles-header">
            <h2>Polecane artykuły</h2>
        </div>
        <div class="related-articles-grid">
            @foreach (var related in Model.RelatedArticles)
            {
                <a href="/artykul/@related.Article.Slug" class="related-card">
                    <img src="@(related.Article.ImageUrl ?? "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=800")" alt="@related.Article.Title" />
                    <div class="related-card-overlay"></div>
                    <div class="related-card-content">
                        <span class="related-card-category">@related.Article.Category.Name</span>
                        <h3>@related.Article.Title</h3>
                        <time>@related.Article.PublishedAt.ToString("d MMMM yyyy")</time>
                    </div>
                </a>
            }
        </div>
    </div>
}

<div class="back-link-container">
    <div class="back-link">
        <a href="/">← Powrót do strony głównej</a>
    </div>
</div>

@section Scripts {
<script>
    function copyLink() {
        navigator.clipboard.writeText('@articleUrl').then(() => {
            document.getElementById('copyText').textContent = 'Skopiowano!';
            setTimeout(() => {
                document.getElementById('copyText').textContent = 'Kopiuj link';
            }, 2000);
        });
    }

    // Podświetlanie aktywnej sekcji w spisie treści
    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = document.querySelectorAll('.article-section');
    
    if (tocLinks.length > 0 && sections.length > 0) {
        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    tocLinks.forEach(link => link.classList.remove('active'));
                    const activeLink = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
                    if (activeLink) activeLink.classList.add('active');
                }
            });
        }, observerOptions);

        sections.forEach(sec => observer.observe(sec));
    }
</script>
}
