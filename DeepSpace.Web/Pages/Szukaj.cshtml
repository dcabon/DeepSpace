@page "/szukaj"
@model DeepSpace.Web.Pages.SzukajModel
@{
    ViewData["Title"] = "Szukaj — Deep Space";
    ViewData["MetaDescription"] = "Wyszukiwarka artykułów Deep Space.";
    ViewData["MetaKeywords"] = "search, szukaj, astronomy, physics, space";
    ViewData["Robots"] = "noindex, follow";
}

<div class="page-header">
    <h1>Szukaj</h1>
    <form method="get" class="search-form">
        <input type="text" name="q" value="@Model.Query" placeholder="Wpisz frazę..." autofocus />
        <button type="submit">Szukaj</button>
    </form>
</div>

<div class="editorial-container">
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <p class="text-muted mb-2">
            @if (Model.Articles.Any())
            {
                <span>Znaleziono @Model.Articles.Count wyników dla „@Model.Query"</span>
            }
            else
            {
                <span>Brak wyników dla „@Model.Query"</span>
            }
        </p>
    }

    @if (Model.Articles.Any())
    {
        <div class="articles-grid">
            @foreach (var article in Model.Articles)
            {
                <article class="article-card">
                    <a href="/artykul/@article.Slug" class="article-link">
                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                        {
                            <div class="article-image-wrapper">
                                <img src="@article.ImageUrl" alt="@article.Title" class="article-image" />
                            </div>
                        }
                        <div class="article-content">
                            <span class="article-category">@article.Category.Name</span>
                            <h3 class="article-title">@article.Title</h3>
                            <p class="article-summary">@article.Summary</p>
                            <div class="article-meta">
                                <time>@article.PublishedAt.ToString("d MMMM yyyy")</time>
                            </div>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
</div>
