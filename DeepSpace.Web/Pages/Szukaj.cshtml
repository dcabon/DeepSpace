@page "/szukaj"
@model DeepSpace.Web.Pages.SzukajModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Query) ? "Szukaj — Deep Space" : $"Wyniki dla \"{Model.Query}\" — Deep Space";
}

<div class="search-header">
    <div class="container-narrow">
        <h1>Szukaj</h1>
        <form method="get" class="search-form">
            <input type="text" name="q" value="@Model.Query" placeholder="Wpisz frazę..." autofocus />
            <button type="submit" class="btn btn-primary">Szukaj</button>
        </form>
    </div>
</div>

<div class="container-narrow">
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <p class="results-count">
            Znaleziono @Model.Articles.Count @(Model.Articles.Count == 1 ? "wynik" : Model.Articles.Count < 5 ? "wyniki" : "wyników")
        </p>

        @if (Model.Articles.Any())
        {
            <section class="articles">
                @foreach (var article in Model.Articles)
                {
                    <article class="article-card">
                        <span class="category-badge">@article.Category.Name</span>
                        <h3><a href="/artykul/@article.Slug">@article.Title</a></h3>
                        <p class="summary">@article.Summary</p>
                        <div class="meta">
                            <time datetime="@article.PublishedAt.ToString("yyyy-MM-dd")">
                                @article.PublishedAt.ToString("d MMMM yyyy")
                            </time>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <p class="empty-state">Nie znaleziono artykułów pasujących do zapytania.</p>
        }
    }

    <div class="back-link">
        <a href="/">← Wróć do strony głównej</a>
    </div>
</div>
