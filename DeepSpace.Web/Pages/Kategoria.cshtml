@page "/kategoria/{slug}"
@model DeepSpace.Web.Pages.KategoriaModel
@{
    ViewData["Title"] = Model.Category!.Name + " — Deep Space";
}

<div class="page-header">
    <h1>@Model.Category.Name</h1>
    @if (!string.IsNullOrEmpty(Model.Category.Description))
    {
        <p>@Model.Category.Description</p>
    }
    <p class="text-muted">@Model.Articles.Count artykułów</p>
</div>

<div class="editorial-container">
    @if (Model.Articles.Any())
    {
        <div class="articles-grid">
            @foreach (var article in Model.Articles)
            {
                <article class="article-card">
                    <a href="/artykul/@article.Slug" class="article-link">
                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                        {
                            <div class="article-image-wrapper">
                                <img src="@article.ImageUrl" alt="@article.Title" class="article-image" />
                            </div>
                        }
                        <div class="article-content">
                            <span class="article-category">@article.Category.Name</span>
                            <h3 class="article-title">@article.Title</h3>
                            <p class="article-summary">@article.Summary</p>
                            <div class="article-meta">
                                <time>@article.PublishedAt.ToString("d MMMM yyyy")</time>
                            </div>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted mt-2">Brak artykułów w tej kategorii.</p>
    }
</div>
