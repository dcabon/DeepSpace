@page "/admin/tags"
@model DeepSpace.Web.Pages.Admin.Tags.IndexModel
@{
    ViewData["Title"] = "Tagi — Admin";
}

<div class="admin-container">
    <div class="admin-header">
        <h1>Tagi</h1>
        <button class="btn btn-primary" onclick="openCreateModal()">+ Nowy tag</button>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>Slug</th>
                <th>Artykuły</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tag in Model.Tags)
            {
                <tr>
                    <td>@tag.Name</td>
                    <td><code>@tag.Slug</code></td>
                    <td>@tag.ArticleTags.Count</td>
                    <td class="actions">
                        <button class="btn-link" onclick="openEditModal(@tag.Id)">Edytuj</button>
                        <button class="btn-link delete" onclick="openDeleteModal(@tag.Id, '@tag.Name.Replace("'", "\\'")')">Usuń</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="back-link">
        <a href="/admin">← Wróć do panelu</a>
    </div>
</div>

<!-- Modal Create/Edit -->
<div id="tagModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTitle">Nowy tag</h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <form id="tagForm" class="admin-form">
            <input type="hidden" id="tagId" name="tag.Id" value="0" />

            <div class="form-group">
                <label for="Name">Nazwa</label>
                <input type="text" id="Name" name="tag.Name" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Anuluj</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Delete -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Usuń tag</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&times;</button>
        </div>
        <div class="delete-confirm">
            <p>Czy na pewno chcesz usunąć tag:</p>
            <h3 id="deleteTitle"></h3>
            <div class="form-actions">
                <button class="btn btn-danger" onclick="confirmDelete()">Tak, usuń</button>
                <button class="btn btn-secondary" onclick="closeDeleteModal()">Anuluj</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentDeleteId = 0;

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Nowy tag';
        document.getElementById('tagForm').reset();
        document.getElementById('tagId').value = '0';
        document.getElementById('tagModal').classList.add('open');
    }

    async function openEditModal(id) {
        document.getElementById('modalTitle').textContent = 'Edytuj tag';

        const response = await fetch(`/admin/tags?handler=Edit&id=${id}`);
        const tag = await response.json();

        document.getElementById('tagId').value = tag.id;
        document.getElementById('Name').value = tag.name || '';

        document.getElementById('tagModal').classList.add('open');
    }

    function closeModal() {
        document.getElementById('tagModal').classList.remove('open');
    }

    function openDeleteModal(id, name) {
        currentDeleteId = id;
        document.getElementById('deleteTitle').textContent = name;
        document.getElementById('deleteModal').classList.add('open');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('open');
    }

    document.getElementById('tagForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(e.target);
        const id = document.getElementById('tagId').value;
        const handler = id === '0' ? 'Create' : 'Edit';

        const token = document.querySelector('input[name="__RequestVerificationToken"]');

        const response = await fetch(`/admin/tags?handler=${handler}`, {
            method: 'POST',
            body: formData,
            headers: token ? { 'RequestVerificationToken': token.value } : {}
        });

        if (response.ok) {
            location.reload();
        }
    });

    async function confirmDelete() {
        const formData = new FormData();
        formData.append('id', currentDeleteId);

        const token = document.querySelector('input[name="__RequestVerificationToken"]');

        const response = await fetch('/admin/tags?handler=Delete', {
            method: 'POST',
            body: formData,
            headers: token ? { 'RequestVerificationToken': token.value } : {}
        });

        if (response.ok) {
            location.reload();
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeModal();
            closeDeleteModal();
        }
    });

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
                closeDeleteModal();
            }
        });
    });
</script>
}

@Html.AntiForgeryToken()
