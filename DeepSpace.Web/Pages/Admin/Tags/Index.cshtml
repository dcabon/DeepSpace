@page "/admin/tags"
@model DeepSpace.Web.Pages.Admin.Tags.IndexModel
@{
ViewData["Title"] = "Tagi";
}

<div class="admin-container">
    <div class="admin-header">
        <h1>Tagi</h1>
        <button class="btn btn-primary" onclick="openCreateModal()">+ Nowy tag</button>
    </div>

    <table class="admin-table">
        <thead>
        <tr>
            <th>Nazwa</th>
            <th>Slug</th>
            <th>Artykuły</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var tag in Model.Tags)
        {
        <tr>
            <td><strong>@tag.Name</strong></td>
            <td><code>@tag.Slug</code></td>
            <td>@tag.ArticleTags.Count</td>
            <td class="actions">
                <button class="btn-link" onclick="openEditModal(@tag.Id, '@tag.Name.Replace("'", "\\'")')">Edytuj</button>
                <button class="btn-link delete" onclick="openDeleteModal(@tag.Id, '@tag.Name.Replace("'", "\\'")')">Usuń</button>
            </td>
        </tr>
        }
        </tbody>
    </table>
</div>

<!-- Modal: Create/Edit -->
<div class="modal" id="tagModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTitle">Nowy tag</h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <form id="tagForm" class="admin-form" onsubmit="return saveTag(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="tagId" name="id" />

            <div class="form-group">
                <label for="name">Nazwa</label>
                <input type="text" id="name" name="name" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Anuluj</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Delete -->
<div class="modal" id="deleteModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Usuń tag</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&times;</button>
        </div>
        <div style="padding: 2rem;">
            <p>Czy na pewno chcesz usunąć tag:</p>
            <p><strong id="deleteTitle"></strong></p>
            <div class="form-actions">
                <button class="btn btn-danger" onclick="confirmDelete()">Usuń</button>
                <button class="btn btn-secondary" onclick="closeDeleteModal()">Anuluj</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentDeleteId = null;

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Nowy tag';
        document.getElementById('tagForm').reset();
        document.getElementById('tagId').value = '';
        document.getElementById('tagModal').classList.add('open');
    }

    function openEditModal(id, name) {
        document.getElementById('modalTitle').textContent = 'Edytuj tag';
        document.getElementById('tagId').value = id;
        document.getElementById('name').value = name;
        document.getElementById('tagModal').classList.add('open');
    }

    function closeModal() {
        document.getElementById('tagModal').classList.remove('open');
    }

    async function saveTag(e) {
        e.preventDefault();

        const formData = new FormData(document.getElementById('tagForm'));
        const id = formData.get('id');
        const handler = id ? 'Edit' : 'Create';

        const response = await fetch(`/admin/tags?handler=${handler}`, {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
            window.location.reload();
        } else {
            alert('Wystąpił błąd');
        }

        return false;
    }

    function openDeleteModal(id, name) {
        currentDeleteId = id;
        document.getElementById('deleteTitle').textContent = name;
        document.getElementById('deleteModal').classList.add('open');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('open');
        currentDeleteId = null;
    }

    async function confirmDelete() {
        if (!currentDeleteId) return;

        const formData = new FormData();
        formData.append('id', currentDeleteId);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        const response = await fetch('/admin/tags?handler=Delete', {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
            window.location.reload();
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeModal();
            closeDeleteModal();
        }
    });
</script>
}
