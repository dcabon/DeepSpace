@page "/admin/articles"
@model DeepSpace.Web.Pages.Admin.Articles.IndexModel
@{
ViewData["Title"] = "Artykuły";
}

<div class="admin-container">
    <div class="admin-header">
        <h1>Artykuły</h1>
        <button class="btn btn-primary" onclick="openCreateModal()">+ Nowy artykuł</button>
    </div>

    <table class="admin-table">
        <thead>
        <tr>
            <th>Tytuł</th>
            <th>Kategoria</th>
            <th>Status</th>
            <th>Wyróżniony</th>
            <th>Data</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var article in Model.Articles)
        {
        <tr>
            <td><strong>@article.Title</strong></td>
            <td>@article.Category.Name</td>
            <td>
                @if (article.IsPublished)
                {
                <span class="status published">Opublikowany</span>
                }
                else
                {
                <span class="status draft">Szkic</span>
                }
            </td>
            <td>
                <form method="post" asp-page-handler="ToggleFeatured" style="display: inline;">
                    <input type="hidden" name="Id" value="@article.Id" />
                    <button type="submit" class="featured-toggle @(article.IsFeaturedInGrid ? "active" : "")" title="@(article.IsFeaturedInGrid ? "Usuń z wyróżnionych" : "Wyróżnij w gridzie")">
                        @(article.IsFeaturedInGrid ? "⭐" : "☆")
                    </button>
                </form>
            </td>
            <td>@article.PublishedAt.ToString("dd.MM.yyyy")</td>
            <td class="actions">
                <a href="/admin/articles/edit/@article.Id" class="btn-link">Edytuj</a>
                <button class="btn-link delete" onclick="openDeleteModal(@article.Id, '@article.Title.Replace("'", "\\'")')">Usuń</button>
            </td>
        </tr>
        }
        </tbody>
    </table>

    @if (!Model.Articles.Any())
    {
    <p class="text-center text-muted mt-2">Brak artykułów. Dodaj pierwszy!</p>
    }
</div>

<!-- Modal: Create/Edit -->
<div class="modal" id="articleModal">
    <div class="modal-content modal-large">
        <div class="modal-header">
            <h2 id="modalTitle">Nowy artykuł</h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <form id="articleForm" class="admin-form" onsubmit="return saveArticle(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="articleId" name="id" />

            <div class="form-group">
                <label for="title">Tytuł</label>
                <input type="text" id="title" name="title" required />
            </div>

            <div class="form-group">
                <label for="summary">Streszczenie</label>
                <textarea id="summary" name="summary" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label for="content">Treść</label>
                <div id="editor"></div>
                <input type="hidden" id="content" name="content" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="categoryId">Kategoria</label>
                    <select id="categoryId" name="categoryId" required>
                        @foreach (var cat in Model.Categories)
                        {
                        <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="tags">Tagi (oddzielone przecinkami)</label>
                    <input type="text" id="tags" name="tags" placeholder="NASA, Mars, kosmos" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="sourceName">Źródło (nazwa)</label>
                    <input type="text" id="sourceName" name="sourceName" />
                </div>
                <div class="form-group">
                    <label for="sourceUrl">Źródło (URL)</label>
                    <input type="url" id="sourceUrl" name="sourceUrl" />
                </div>
            </div>

            <div class="form-group">
                <label for="imageUrl">URL obrazka</label>
                <input type="url" id="imageUrl" name="imageUrl" />
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" id="isPublished" name="isPublished" value="true" checked />
                    Opublikowany
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Anuluj</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Delete -->
<div class="modal" id="deleteModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Usuń artykuł</h2>
            <button class="modal-close" onclick="closeDeleteModal()">&times;</button>
        </div>
        <div style="padding: 2rem;">
            <p>Czy na pewno chcesz usunąć artykuł:</p>
            <p><strong id="deleteTitle"></strong></p>
            <div class="form-actions">
                <button class="btn btn-danger" onclick="confirmDelete()">Usuń</button>
                <button class="btn btn-secondary" onclick="closeDeleteModal()">Anuluj</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    let quill;
    let currentDeleteId = null;

    document.addEventListener('DOMContentLoaded', function() {
        quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });
    });

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Nowy artykuł';
        document.getElementById('articleForm').reset();
        document.getElementById('articleId').value = '';
        quill.root.innerHTML = '';
        document.getElementById('articleModal').classList.add('open');
    }

    async function openEditModal(id) {
        const response = await fetch(`/admin/articles?handler=Article&id=${id}`);
        const article = await response.json();

        document.getElementById('modalTitle').textContent = 'Edytuj artykuł';
        document.getElementById('articleId').value = article.id;
        document.getElementById('title').value = article.title;
        document.getElementById('summary').value = article.summary || '';
        quill.root.innerHTML = article.content || '';
        document.getElementById('categoryId').value = article.categoryId;
        document.getElementById('tags').value = article.tags || '';
        document.getElementById('sourceName').value = article.sourceName || '';
        document.getElementById('sourceUrl').value = article.sourceUrl || '';
        document.getElementById('imageUrl').value = article.imageUrl || '';
        document.getElementById('isPublished').checked = article.isPublished;

        document.getElementById('articleModal').classList.add('open');
    }

    function closeModal() {
        document.getElementById('articleModal').classList.remove('open');
    }

    async function saveArticle(e) {
        e.preventDefault();

        document.getElementById('content').value = quill.root.innerHTML;

        const formData = new FormData(document.getElementById('articleForm'));
        const id = formData.get('id');
        const handler = id ? 'Edit' : 'Create';

        const response = await fetch(`/admin/articles?handler=${handler}`, {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
            window.location.reload();
        } else {
            alert('Wystąpił błąd podczas zapisywania');
        }

        return false;
    }

    function openDeleteModal(id, title) {
        currentDeleteId = id;
        document.getElementById('deleteTitle').textContent = title;
        document.getElementById('deleteModal').classList.add('open');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('open');
        currentDeleteId = null;
    }

    async function confirmDelete() {
        if (!currentDeleteId) return;

        const formData = new FormData();
        formData.append('id', currentDeleteId);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        const response = await fetch('/admin/articles?handler=Delete', {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
            window.location.reload();
        }
    }

    // Close modals on ESC
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeModal();
            closeDeleteModal();
        }
    });
</script>
}
