@page "/admin/settings"
@model DeepSpace.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Ustawienia SEO i strony";
}

<div class="admin-container">
    <div class="admin-header">
        <h1>Ustawienia strony</h1>
        <a href="/admin" class="btn btn-secondary">← Powrót</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div style="margin: 1rem 0; padding: 1rem; border: 1px solid #b8e6c0; background: #eafaf0; color: #14532d;">
            @Model.StatusMessage
        </div>
    }

    <form method="post" enctype="multipart/form-data" class="admin-form">
        <div class="form-group">
            <label asp-for="Input.SiteTitle">Tytuł strony (SEO)</label>
            <input asp-for="Input.SiteTitle" />
            <span asp-validation-for="Input.SiteTitle" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.SeoDescription">Opis SEO</label>
            <textarea asp-for="Input.SeoDescription" rows="3"></textarea>
            <span asp-validation-for="Input.SeoDescription" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.SeoKeywords">Słowa kluczowe SEO</label>
            <input asp-for="Input.SeoKeywords" placeholder="space, physics, astronomy, ..." />
            <span asp-validation-for="Input.SeoKeywords" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.HomePageH1">H1 na stronie głównej</label>
                <input asp-for="Input.HomePageH1" />
                <span asp-validation-for="Input.HomePageH1" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.HomePageSubtitle">Undertitle na stronie głównej</label>
                <input asp-for="Input.HomePageSubtitle" />
                <span asp-validation-for="Input.HomePageSubtitle" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label for="faviconFile">Favicon (import pliku)</label>
            <input id="faviconFile" asp-for="FaviconFile" type="file" accept=".ico,.png,.jpg,.jpeg,.webp" />
            <small class="text-muted">Dozwolone: .ico, .png, .jpg, .jpeg, .webp. Max 1 MB.</small>
            <span asp-validation-for="FaviconFile" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Aktualny favicon</label>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <img src="@Model.CurrentFaviconPath" alt="Aktualny favicon" style="width: 32px; height: 32px; object-fit: contain; border: 1px solid var(--border-color); border-radius: 6px; padding: 3px;" />
                <code>@Model.CurrentFaviconPath</code>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Zapisz ustawienia</button>
            <a href="/admin" class="btn btn-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
