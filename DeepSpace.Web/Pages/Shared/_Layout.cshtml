@using DeepSpace.Core.Entities
@using DeepSpace.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject AppDbContext DbContext

@{
    var siteSettings = await DbContext.SiteSettings
        .AsNoTracking()
        .OrderBy(s => s.Id)
        .FirstOrDefaultAsync() ?? new SiteSettings();

    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString() ?? $"{baseUrl}{request.Path}";
    var siteTitle = siteSettings.SiteTitle;
    var pageTitle = ViewData["Title"]?.ToString();
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? siteTitle : pageTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? siteSettings.SeoDescription;
    var metaKeywords = ViewData["MetaKeywords"]?.ToString() ?? siteSettings.SeoKeywords;
    var ogTitle = ViewData["OgTitle"]?.ToString() ?? fullTitle;
    var ogDescription = ViewData["OgDescription"]?.ToString() ?? metaDescription;
    var ogImage = ViewData["OgImage"]?.ToString();
    if (string.IsNullOrWhiteSpace(ogImage))
    {
        ogImage = $"{baseUrl}/images/logo.svg";
    }
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
    var robots = ViewData["Robots"]?.ToString() ??
                 (request.Path.StartsWithSegments("/admin")
                     ? "noindex, nofollow"
                     : "index, follow, max-image-preview:large");
    var faviconPath = string.IsNullOrWhiteSpace(siteSettings.FaviconPath) ? "/favicon.ico" : siteSettings.FaviconPath;
    var isAdmin = User.Identity?.IsAuthenticated == true;

    var websiteSchemaJson = JsonSerializer.Serialize(new
    {
        @context = "https://schema.org",
        @type = "WebSite",
        name = siteTitle,
        url = baseUrl,
        inLanguage = "pl-PL",
        description = metaDescription
    });
}

<!DOCTYPE html>
<html lang="pl" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="robots" content="@robots" />
    <meta name="theme-color" content="#8b2c2a" />
    <link rel="canonical" href="@canonicalUrl" />

    <link rel="icon" href="@faviconPath" />
    <link rel="shortcut icon" href="@faviconPath" />
    <link rel="apple-touch-icon" href="@faviconPath" />

    <meta property="og:title" content="@ogTitle" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="@siteTitle" />
    <meta property="og:locale" content="pl_PL" />
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@ogDescription" />
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
    }

    <script type="application/ld+json">@Html.Raw(websiteSchemaJson)</script>

    <link rel="stylesheet" href="~/css/site.css?v=3" />
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
</head>
<body class="@(isAdmin ? "has-admin-bar" : null)">
    @if (isAdmin)
    {
        <div class="admin-bar">
            <a href="/admin" class="admin-bar-title">Panel Administracyjny</a>
            <div class="admin-bar-user">
                <span>Zalogowany: <strong>@User.Identity!.Name</strong></span>
                <form method="post" asp-page="/Admin/Logout">
                    <button type="submit" class="admin-bar-logout">Wyloguj</button>
                </form>
            </div>
        </div>
    }
    <nav class="navbar" id="navbar">
        <div class="navbar-inner">
            <a href="/" class="navbar-brand">
                <img src="/images/logo.svg?v=2" alt="Deep Space" class="navbar-logo" />
            </a>
            <div class="navbar-links">
                <a href="/">Start</a>
                <div class="navbar-dropdown">
                    <span class="navbar-dropdown-btn">Kategorie ▾</span>
                    <div class="navbar-dropdown-content">
                        <partial name="_CategoriesMenu" />
                    </div>
                </div>
                <a href="/quizy">Quizy</a>
                <a href="/szukaj">Szukaj</a>
                <button class="theme-toggle" id="themeToggle" title="Zmień motyw">
                    <span class="theme-icon-dark">🌙</span>
                    <span class="theme-icon-light">☀️</span>
                </button>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; 2026 Deep Space — Astronomia i fizyka bez clickbaitu</p>
        <p class="footer-links">
            <a href="/privacy">Polityka prywatności</a>
            <span class="footer-separator">|</span>
            <button type="button" class="cookie-settings-btn" id="openCookieSettings">Ustawienia cookies</button>
        </p>
    </footer>

    <!-- Cookie Consent Modal -->
    <div class="cookie-modal-overlay" id="cookieConsent">
        <div class="cookie-modal">
            <div class="cookie-modal-header">
                <span class="cookie-icon">🍪</span>
                <h3>Ta strona używa plików cookies</h3>
            </div>
            <div class="cookie-modal-body">
                <p>
                    Używamy plików cookies do analizy ruchu na stronie (Google Analytics),
                    co pomaga nam ulepszać serwis. Możesz zaakceptować wszystkie cookies
                    lub je odrzucić.
                </p>
                <a href="/privacy" class="cookie-privacy-link">Przeczytaj Politykę Prywatności →</a>
            </div>
            <div class="cookie-modal-actions">
                <button type="button" class="cookie-btn cookie-btn-reject" id="cookieReject">Odrzuć</button>
                <button type="button" class="cookie-btn cookie-btn-accept" id="cookieAccept">Akceptuję wszystkie</button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
        });

        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        const savedTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-theme', savedTheme);

        themeToggle.addEventListener('click', () => {
            const newTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        // Cookie Consent Management
        (function() {
            const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX'; // Replace with your actual GA4 Measurement ID
            const COOKIE_CONSENT_KEY = 'cookie_consent';

            const cookieModal = document.getElementById('cookieConsent');
            const acceptBtn = document.getElementById('cookieAccept');
            const rejectBtn = document.getElementById('cookieReject');
            const settingsBtn = document.getElementById('openCookieSettings');

            if (!cookieModal || !acceptBtn || !rejectBtn) {
                console.error('Cookie consent elements not found');
                return;
            }

            function showModal() {
                cookieModal.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function hideModal() {
                cookieModal.classList.remove('show');
                document.body.style.overflow = '';
            }

            function loadGoogleAnalytics() {
                if (document.getElementById('ga-script')) return;

                const script = document.createElement('script');
                script.id = 'ga-script';
                script.async = true;
                script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
                document.head.appendChild(script);

                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                window.gtag = gtag;
                gtag('js', new Date());
                gtag('config', GA_MEASUREMENT_ID, {
                    'anonymize_ip': true
                });
            }

            function removeGACookies() {
                window['ga-disable-' + GA_MEASUREMENT_ID] = true;
                const cookies = document.cookie.split(';');
                for (let cookie of cookies) {
                    const name = cookie.split('=')[0].trim();
                    if (name.startsWith('_ga') || name.startsWith('_gid')) {
                        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    }
                }
            }

            // Event: Accept cookies
            acceptBtn.onclick = function() {
                localStorage.setItem(COOKIE_CONSENT_KEY, 'accepted');
                hideModal();
                loadGoogleAnalytics();
            };

            // Event: Reject cookies
            rejectBtn.onclick = function() {
                localStorage.setItem(COOKIE_CONSENT_KEY, 'rejected');
                hideModal();
                removeGACookies();
            };

            // Event: Open settings (reshow modal)
            if (settingsBtn) {
                settingsBtn.onclick = function() {
                    showModal();
                };
            }

            // Check on page load
            const consent = localStorage.getItem(COOKIE_CONSENT_KEY);
            if (consent === 'accepted') {
                loadGoogleAnalytics();
            } else if (consent === 'rejected') {
                removeGACookies();
            } else {
                // No consent yet - show modal
                showModal();
            }
        })();
    </script>
</body>
</html>
